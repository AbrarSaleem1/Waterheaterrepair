---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import siteConfig from '../../data/site-config.json';
import { getAllStates } from '../../utils/locations';

const allStates = getAllStates().sort((a, b) => a.name.localeCompare(b.name));

const totalZips = allStates.reduce((acc, s) => acc + (s.totalZips || 0), 0);
const totalCities = allStates.reduce((acc, s) => acc + (s.uniqueCities || 0), 0);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Locations' }
];

const locationsSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Nationwide Water Heater Repair & Installation Service Areas",
  "provider": {
    "@type": "PlumbingService",
    "name": siteConfig.businessName,
    "telephone": siteConfig.phone,
    "url": siteConfig.domain
  },
  "areaServed": allStates.map(s => ({
    "@type": "State",
    "name": s.name
  }))
};
---

<BaseLayout
  title={`Water Heater Repair Near Me — All 50 States Service Directory | ${siteConfig.businessName}`}
  description="Find certified local water heater repair and replacement technicians across all 50 states. Over 14,000 cities covered with 24/7 emergency service."
  breadcrumbs={breadcrumbs}
  jsonLd={locationsSchema}
>
  <Hero
    title="Nationwide Water Heater Service Areas"
    subtitle={`Providing fast, licensed water heater repair and replacement across all 50 US states, servicing over ${totalCities.toLocaleString()} cities and ${totalZips.toLocaleString()} zip codes.`}
    breadcrumbs={breadcrumbs}
    variant="short"
  />

  <TrustStrip />

  <!-- Directory Stats Strip -->
  <section class="stats-strip">
    <div class="container stats-grid">
      <div class="stat-box">
        <strong>50</strong>
        <span>US States Covered</span>
      </div>
      <div class="stat-box">
        <strong>14,000+</strong>
        <span>Cities Serviced</span>
      </div>
      <div class="stat-box">
        <strong>23,000+</strong>
        <span>Zip Codes Reached</span>
      </div>
      <div class="stat-box">
        <strong>24/7</strong>
        <span>Emergency On-Call</span>
      </div>
    </div>
  </section>

  <!-- States Directory -->
  <section class="section">
    <div class="container">
      <div class="text-center">
        <span class="badge badge-navy">Browse by State</span>
        <h2 class="section-title">Select Your State to Find Local Plumbers</h2>
        <p class="section-subtitle">
          Click your state below to view covered cities, local water hardness profiles, building code requirements, and direct emergency dispatch numbers.
        </p>
      </div>

      <div class="states-cards-grid">
        {allStates.map((state) => (
          <a href={`/locations/${state.slug}/`} class="state-directory-card card">
            <div class="card-body">
              <div class="state-card-header">
                <span class="state-badge-abbr">{state.abbr}</span>
                <h3 class="state-card-name">{state.name}</h3>
              </div>
              <div class="state-card-stats">
                {state.uniqueCities ? (
                  <span>📍 {state.uniqueCities} Cities Covered</span>
                ) : (
                  <span>📍 Full State Coverage</span>
                )}
                {state.totalZips ? (
                  <span>📮 {state.totalZips} Zip Codes</span>
                ) : null}
              </div>
              <span class="state-card-cta">
                View Local Services
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="cta-band">
    <div class="container cta-band-inner text-center">
      <h2>Can't Find Your Exact City Listed?</h2>
      <p>Our network of licensed plumbing contractors expands every week. Call our dispatch desk to confirm service at your address.</p>
      <div class="cta-band-actions">
        <a href={`tel:${siteConfig.phone}`} class="btn btn-primary btn-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call {siteConfig.phoneFormatted}
        </a>
        <a href="/contact-us/" class="btn btn-secondary btn-lg">Check Address Availability</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .stats-strip {
    background: var(--color-white);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-gray-200);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    text-align: center;
  }

  .stat-box strong {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    color: var(--color-navy);
    display: block;
    line-height: 1;
  }

  .stat-box span {
    font-size: var(--text-xs);
    color: var(--color-charcoal-light);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-top: var(--space-1);
    display: block;
  }

  .states-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }

  .state-directory-card {
    text-decoration: none;
    color: inherit;
    border-top: 3px solid var(--color-navy);
    transition: all var(--transition-base);
  }

  .state-directory-card:hover {
    border-top-color: var(--color-orange);
  }

  .state-card-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .state-badge-abbr {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    background: rgba(27, 42, 74, 0.08);
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .state-directory-card:hover .state-badge-abbr {
    background: var(--color-navy);
    color: var(--color-white);
  }

  .state-card-name {
    font-size: var(--text-base);
    color: var(--color-navy);
    margin: 0;
  }

  .state-card-stats {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-charcoal-light);
    margin-bottom: var(--space-4);
  }

  .state-card-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-orange);
    transition: gap var(--transition-fast);
  }

  .state-directory-card:hover .state-card-cta {
    gap: var(--space-2);
  }

  .cta-band {
    background: var(--color-navy);
    color: var(--color-white);
    padding-block: var(--space-16);
  }

  .cta-band h2 {
    color: var(--color-white);
    font-size: var(--text-3xl);
    margin-bottom: var(--space-2);
  }

  .cta-band p {
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--text-base);
    max-width: 600px;
    margin-inline: auto;
    margin-bottom: var(--space-6);
  }

  .cta-band-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  @media (max-width: 1024px) {
    .states-cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .states-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .states-cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
