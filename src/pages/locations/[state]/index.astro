---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/Hero.astro';
import TrustStrip from '../../../components/TrustStrip.astro';
import CitiesGrid from '../../../components/CitiesGrid.astro';
import ServicesGrid from '../../../components/ServicesGrid.astro';
import siteConfig from '../../../data/site-config.json';
import { getAllStates, getCitiesForState, getTopCitiesForState } from '../../../utils/locations';

export async function getStaticPaths() {
  const states = getAllStates();
  return states.map((state) => ({
    params: { state: state.slug },
    props: { state },
  }));
}

const { state } = Astro.props;

// Fetch all cities and top cities for this state
const allCitiesInState = getCitiesForState(state.abbr);
const topCities = getTopCitiesForState(state.abbr, 36);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Locations', href: '/locations/' },
  { label: state.name }
];

const stateFaqs = [
  {
    q: `How quickly can a plumber arrive at my home in ${state.name}?`,
    a: `In most metropolitan areas across ${state.name}, our licensed emergency plumbers arrive within 45 to 75 minutes. For scheduled routine replacements or maintenance, we offer flexible same-day and next-day appointment windows.`
  },
  {
    q: `What are the state plumbing codes for water heater replacements in ${state.name}?`,
    a: `Replacements in ${state.name} must adhere to current uniform plumbing codes, including temperature-and-pressure (T&P) safety relief valve piping, dielectric isolation fittings, proper combustion air ventilation for gas units, and thermal expansion tanks on closed municipal lines.`
  },
  {
    q: `Do you service both gas and electric water heaters in ${state.name}?`,
    a: `Yes! Our certified ${state.name} technicians repair, replace, and install electric storage tanks, natural gas and LP propane units, high-efficiency heat pumps, and endless tankless systems.`
  },
  {
    q: `Are your ${state.name} plumbers licensed and insured?`,
    a: `Every technician operating under our network in ${state.name} carries state licensing, active commercial liability insurance, and comprehensive worker's compensation coverage.`
  }
];

const stateSchema = {
  "@context": "https://schema.org",
  "@type": "PlumbingService",
  "name": `${siteConfig.businessName} — ${state.name}`,
  "telephone": siteConfig.phone,
  "url": `${siteConfig.domain}/locations/${state.slug}/`,
  "areaServed": {
    "@type": "State",
    "name": state.name
  },
  "description": `24/7 water heater repair, replacement, and installation services across ${state.name}. Covering ${allCitiesInState.length || state.uniqueCities || 'all'} cities with licensed local plumbers.`
};
---

<BaseLayout
  title={`Water Heater Repair & Replacement in ${state.name} | ${siteConfig.businessName}`}
  description={`Looking for water heater repair in ${state.name}? Our licensed plumbers provide 24/7 emergency service, tankless installation, and code-compliant replacements across ${state.name}. Call now!`}
  breadcrumbs={breadcrumbs}
  jsonLd={stateSchema}
>
  <Hero
    title={`Water Heater Repair & Installation in ${state.name}`}
    subtitle={`Serving homeowners and commercial businesses across ${state.name} with fast 24/7 emergency diagnostics, leak repairs, and same-day replacements.`}
    breadcrumbs={breadcrumbs}
    variant="short"
  />

  <TrustStrip />

  <!-- State Metrics Bar -->
  <section class="state-metrics">
    <div class="container metrics-inner">
      <div class="metric-item">
        <span class="metric-val">{allCitiesInState.length || state.uniqueCities || '50+'}</span>
        <span class="metric-lbl">Cities Served in {state.name}</span>
      </div>
      <div class="metric-item">
        <span class="metric-val">{state.totalZips || '100+'}</span>
        <span class="metric-lbl">Covered Zip Codes</span>
      </div>
      <div class="metric-item">
        <span class="metric-val">45 – 75 Min</span>
        <span class="metric-lbl">Average Emergency Arrival</span>
      </div>
      <div class="metric-item">
        <span class="metric-val">24/7</span>
        <span class="metric-lbl">Dispatch Hotline</span>
      </div>
    </div>
  </section>

  <!-- Covered Cities Directory -->
  <section class="section">
    <div class="container">
      <div class="text-center">
        <span class="badge badge-navy">{state.name} Service Locations</span>
        <h2 class="section-title">Covered Cities & Municipalities in {state.name}</h2>
        <p class="section-subtitle">
          Select your local city below to view dedicated emergency dispatch options, local water hardness ratings, and zip code coverage:
        </p>
      </div>

      {allCitiesInState.length > 0 ? (
        <CitiesGrid cities={topCities} />
      ) : (
        <div class="card text-center" style="padding: var(--space-8);">
          <h3>Statewide Coverage in {state.name}</h3>
          <p>We provide dispatch across all counties and postal areas in {state.name}. Call our hotline to verify technician availability for your address.</p>
          <a href={`tel:${siteConfig.phone}`} class="btn btn-primary btn-lg" style="margin-top: var(--space-4);">
            Call {siteConfig.phoneFormatted}
          </a>
        </div>
      )}

      {allCitiesInState.length > topCities.length && (
        <div class="cities-all-card card card-sm" style="margin-top: var(--space-8);">
          <div class="card-body">
            <h4>Additional {state.name} Communities Served:</h4>
            <p class="cities-overflow-list">
              {allCitiesInState.slice(topCities.length, 120).map((c, i) => (
                <span>
                  <a href={`/locations/${state.slug}/${c.slug}/`}>{c.name}</a>
                  {i < Math.min(allCitiesInState.length - topCities.length, 120) - 1 ? ' • ' : ''}
                </span>
              ))}
            </p>
            {allCitiesInState.length > 120 && (
              <p class="overflow-note">+ and {allCitiesInState.length - 120} more communities throughout {state.name}.</p>
            )}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- State-Specific Plumbing Services -->
  <section class="section" style="background-color: var(--color-white);">
    <div class="container">
      <div class="text-center">
        <span class="badge badge-orange">Comprehensive Solutions</span>
        <h2 class="section-title">Water Heater Services Available in {state.name}</h2>
        <p class="section-subtitle">
          Our certified {state.name} technicians handle all major system configurations, from compact electric tanks to commercial boiler systems.
        </p>
      </div>

      <ServicesGrid />
    </div>
  </section>

  <!-- State FAQs -->
  <section class="section">
    <div class="container container-narrow">
      <div class="text-center">
        <span class="badge badge-navy">Frequently Asked Questions</span>
        <h2 class="section-title">{state.name} Water Heater FAQs</h2>
        <p class="section-subtitle">
          Helpful answers for homeowners and property managers in {state.name}.
        </p>
      </div>

      <div class="faq-list">
        {stateFaqs.map((faq, idx) => (
          <details class="faq-item card" open={idx === 0}>
            <summary class="faq-question">
              <span>{faq.q}</span>
              <span class="faq-arrow">+</span>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- State CTA Band -->
  <section class="cta-band">
    <div class="container cta-band-inner text-center">
      <h2>Need Water Heater Repair in {state.name}?</h2>
      <p>Contact our local dispatch team for an immediate response, upfront quote, and licensed plumber at your door.</p>
      <div class="cta-band-actions">
        <a href={`tel:${siteConfig.phone}`} class="btn btn-primary btn-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call {siteConfig.phoneFormatted}
        </a>
        <a href="/contact-us/" class="btn btn-secondary btn-lg">Schedule Online</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .state-metrics {
    background: var(--color-white);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-gray-200);
  }

  .metrics-inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    text-align: center;
  }

  .metric-val {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-navy);
    display: block;
    line-height: 1;
  }

  .metric-lbl {
    font-size: var(--text-xs);
    color: var(--color-charcoal-light);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-top: var(--space-1);
    display: block;
  }

  .cities-overflow-list {
    font-size: var(--text-sm);
    line-height: 1.8;
    color: var(--color-charcoal-light);
    margin-top: var(--space-2);
  }

  .cities-overflow-list a {
    color: var(--color-navy);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cities-overflow-list a:hover {
    color: var(--color-orange);
  }

  .overflow-note {
    font-size: var(--text-xs);
    color: var(--color-gray-500);
    margin-top: var(--space-2);
    font-style: italic;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-question {
    padding: var(--space-4) var(--space-5);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-base);
    color: var(--color-navy);
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-arrow {
    color: var(--color-orange);
    font-size: 1.3rem;
  }

  details[open] .faq-arrow {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 var(--space-5) var(--space-4);
    color: var(--color-charcoal-light);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .cta-band {
    background: var(--color-navy);
    color: var(--color-white);
    padding-block: var(--space-16);
  }

  .cta-band h2 {
    color: var(--color-white);
    font-size: var(--text-3xl);
    margin-bottom: var(--space-2);
  }

  .cta-band p {
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--text-base);
    max-width: 600px;
    margin-inline: auto;
    margin-bottom: var(--space-6);
  }

  .cta-band-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .metrics-inner {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }
  }
</style>
