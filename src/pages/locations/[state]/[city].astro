---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/Hero.astro';
import TrustStrip from '../../../components/TrustStrip.astro';
import siteConfig from '../../../data/site-config.json';
import services from '../../../data/services.json';
import { getAllStates, getCitiesForState, slugify, type CityInfo, type StateInfo } from '../../../utils/locations';
import { generateCitySEO } from '../../../utils/city-seo-generator';

export async function getStaticPaths() {
  const states = getAllStates();
  const paths = [];

  for (const state of states) {
    const stateCities = getCitiesForState(state.abbr);
    stateCities.sort((a, b) => b.topPayout - a.topPayout);

    // Deduplicate city slugs within the same state
    const seenSlugs = new Set<string>();
    const uniqueCities: CityInfo[] = [];

    for (const c of stateCities) {
      if (!seenSlugs.has(c.slug)) {
        seenSlugs.add(c.slug);
        uniqueCities.push(c);
      }
    }

    // Generate all unique cities in the dataset so no city ever 404s
    const targetCities = uniqueCities;

    const first7 = targetCities.slice(0, 7);

    for (const city of targetCities) {
      // Fast sister cities lookup from top candidates
      const sisterCities = first7
        .filter(c => c.slug !== city.slug)
        .slice(0, 6);

      paths.push({
        params: {
          state: state.slug,
          city: city.slug,
        },
        props: {
          state,
          city,
          sisterCities,
        },
      });
    }
  }

  return paths;
}

interface Props {
  state: StateInfo;
  city: CityInfo;
  sisterCities: CityInfo[];
}

const { state, city, sisterCities } = Astro.props;

// Generate rich programmatic content with unique angles, water profiles, and local codes
const seoData = generateCitySEO(city, state);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Locations', href: '/locations/' },
  { label: state.name, href: `/locations/${state.slug}/` },
  { label: city.name },
];

const citySchema = {
  "@context": "https://schema.org",
  "@type": "PlumbingService",
  "name": `${siteConfig.businessName} — ${city.name}, ${state.abbr}`,
  "telephone": siteConfig.phone,
  "url": `${siteConfig.domain}/locations/${state.slug}/${city.slug}/`,
  "image": `${siteConfig.domain}/images/logo.png`,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": city.name,
    "addressRegion": state.abbr,
    "postalCode": city.zips[0] || state.abbr,
    "addressCountry": "US",
  },
  "areaServed": {
    "@type": "City",
    "name": city.name,
    "containedInPlace": {
      "@type": "State",
      "name": state.name,
    },
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    "opens": "00:00",
    "closes": "23:59",
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": seoData.localFaqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a,
    },
  })),
};
---

<BaseLayout
  title={`${seoData.heroTitle} | 24/7 Service | ${siteConfig.businessName}`}
  description={`Need water heater repair or installation in ${city.name}, ${state.abbr}? Licensed 24/7 emergency plumbers covering zip code${city.zips.length > 1 ? 's' : ''} ${city.zips.slice(0, 3).join(', ')}. Same-day service & upfront phone estimates!`}
  breadcrumbs={breadcrumbs}
  jsonLd={[citySchema, faqSchema]}
>
  <Hero
    title={seoData.heroTitle}
    subtitle={seoData.heroSubtitle}
    breadcrumbs={breadcrumbs}
    variant="short"
    backgroundImage="/images/hero.jpg"
  />

  <TrustStrip />

  <!-- Local Emergency Notification Strip -->
  <section class="city-emergency-bar">
    <div class="container emergency-bar-inner">
      <div class="emergency-bar-left">
        <span class="live-pulse"></span>
        <div>
          <strong>Emergency Plumber Available in {city.name}, {state.abbr}</strong>
          <span>{seoData.emergencyHighlight}</span>
        </div>
      </div>
      <a href={`tel:${siteConfig.phone}`} class="btn btn-primary btn-sm">
        Call {siteConfig.phoneFormatted}
      </a>
    </div>
  </section>

  <!-- Main City Content Section -->
  <section class="section">
    <div class="container">
      <div class="city-layout">
        <!-- Main Body -->
        <div class="city-main-content">
          <!-- Unique Angle Intro -->
          <div class="intro-block">
            <span class="badge badge-orange">{city.name}, {state.abbr} Plumbing Specialist</span>
            <h2>{seoData.introHeading}</h2>
            <p class="city-lead-p">{seoData.introParagraph1}</p>
            <p>{seoData.introParagraph2}</p>
          </div>

          <!-- Zip Code Coverage Badge Box -->
          <div class="zips-box card card-sm">
            <div class="card-body">
              <div class="zips-header">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="zips-icon"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <h4>Covered Postal Codes in {city.name}:</h4>
              </div>
              <p class="zips-sub">Our service trucks are dispatched to all residential and commercial addresses throughout:</p>
              <div class="zips-tags">
                {city.zips.map((zip) => (
                  <span class="zip-tag">{zip}</span>
                ))}
              </div>
            </div>
          </div>

          <!-- Local Water Quality & Mineral Profile -->
          <div class="water-profile-block card">
            <div class="card-body">
              <div class="profile-header">
                <span class="water-icon">💧</span>
                <div>
                  <span class="profile-tag">Municipal Water Analysis</span>
                  <h3>{city.name} Water Hardness Profile</h3>
                </div>
              </div>

              <div class="profile-stats-grid">
                <div class="p-stat">
                  <span class="p-label">Hardness Classification:</span>
                  <strong class="p-value">{seoData.waterProfile.hardnessCategory}</strong>
                </div>
                <div class="p-stat">
                  <span class="p-label">Est. Mineral Level:</span>
                  <strong class="p-value">{seoData.waterProfile.ppmEstimate} ({seoData.waterProfile.gpgEstimate})</strong>
                </div>
              </div>

              <p class="water-impact-text">{seoData.waterProfile.waterImpact}</p>
              
              <div class="maintenance-box">
                <strong>💡 Local Maintenance Recommendation:</strong>
                <p>{seoData.waterProfile.maintenanceTip}</p>
              </div>

              <div class="anode-box" style="margin-top: var(--space-3); padding: var(--space-3); background: #f4f6f9; border-radius: var(--radius-sm);">
                <strong style="font-size: var(--text-xs); color: var(--color-navy); display: block; margin-bottom: 2px;">🛡️ Anode Rod Specification for {city.name}:</strong>
                <span style="font-size: var(--text-xs); color: var(--color-charcoal);">{seoData.waterProfile.anodeRecommendation}</span>
              </div>
            </div>
          </div>

          <!-- Professional Field Service Image Banner -->
          <div class="city-photo-banner card" style="overflow: hidden; margin-block: var(--space-6);">
            <img src="/images/repair.jpg" alt={`Licensed technician diagnosing water heater in ${city.name}`} loading="lazy" style="width: 100%; height: 260px; object-fit: cover; display: block;" />
            <div class="card-body" style="padding: var(--space-3) var(--space-4); background: var(--color-gray-50);">
              <span style="font-size: var(--text-xs); color: var(--color-charcoal-light);">
                📸 <em>Certified master technician testing electrical heating elements and thermostat controls on-site in {city.name}, {state.abbr}.</em>
              </span>
            </div>
          </div>

          <!-- Technical Diagnostic Matrix Table -->
          <div class="card diagnostic-card">
            <div class="card-body">
              <div class="code-header">
                <span class="code-icon">🔬</span>
                <div>
                  <span class="profile-tag">Field Diagnostic Guide</span>
                  <h3>{city.name} Water Heater Troubleshooting Matrix</h3>
                </div>
              </div>
              <p style="font-size: var(--text-sm); color: var(--color-charcoal-light); margin-bottom: var(--space-4);">
                Our licensed {city.name} plumbers follow strict mechanical troubleshooting protocols to isolate root causes without replacing parts unnecessarily.
              </p>
              <div class="table-responsive">
                <table class="diag-table">
                  <thead>
                    <tr>
                      <th>Symptom Observed</th>
                      <th>Root Mechanical Cause</th>
                      <th>Diagnostic Verification</th>
                      <th>Local Action Protocol</th>
                    </tr>
                  </thead>
                  <tbody>
                    {seoData.diagnosticMatrix.map((row) => (
                      <tr>
                        <td><strong>{row.symptom}</strong></td>
                        <td>{row.cause}</td>
                        <td><code>{row.testMethod}</code></td>
                        <td>{row.localAction}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- Plumbing Code & Safety Regulations in City/State -->
          <div class="code-block card">
            <div class="card-body">
              <div class="code-header">
                <span class="code-icon">📋</span>
                <div>
                  <span class="profile-tag">{state.name} Uniform Plumbing Code</span>
                  <h3>Local {city.name} Code & Permitting Guidelines</h3>
                </div>
              </div>
              <p class="code-text">{seoData.plumbingCodeNote}</p>
              <ul class="code-checklist">
                <li>Professional permit pull & post-installation inspection included</li>
                <li>ASME-rated temperature-and-pressure safety relief valve installation</li>
                <li>Thermal expansion tank tested against city static water pressure</li>
                <li>Combustion air ventilation and draft testing for gas appliances</li>
              </ul>
            </div>
          </div>

          <!-- Phone Estimate & Diagnostic Guide for City -->
          <div class="pricing-block card">
            <div class="card-body">
              <h3>Water Heater Estimate & Service Process in {city.name}, {state.abbr}</h3>
              <p class="pricing-note">
                Because every water heater system has unique requirements, we provide upfront estimates directly over the phone and confirm exact written specifications on-site before any work begins.
              </p>

              <div class="pricing-grid">
                <div class="price-card">
                  <span class="price-title">Step 1: 24/7 Call</span>
                  <span class="price-desc">{seoData.estimateProcess.step1}</span>
                </div>
                <div class="price-card">
                  <span class="price-title">Step 2: Phone Estimate</span>
                  <span class="price-desc">{seoData.estimateProcess.step2}</span>
                </div>
                <div class="price-card">
                  <span class="price-title">Step 3: On-Site Inspection</span>
                  <span class="price-desc">{seoData.estimateProcess.step3}</span>
                </div>
                <div class="price-card">
                  <span class="price-title">Step 4: Guaranteed Service</span>
                  <span class="price-desc">{seoData.estimateProcess.step4}</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Services List in City -->
          <div class="city-services-section">
            <h3>Full Water Heating Services Provided in {city.name}</h3>
            <div class="city-services-grid">
              {services.map((svc) => (
                <div class="city-service-item card card-sm">
                  <div class="card-body">
                    <h4>{svc.shortName} in {city.name}</h4>
                    <p>{svc.shortDescription}</p>
                    <a href={`/services/${svc.slug}/`} class="service-read-more">Learn more about {svc.shortName} →</a>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Local FAQs -->
          <div class="city-faqs-section">
            <h3>Frequently Asked Questions in {city.name}, {state.abbr}</h3>
            <div class="faq-list">
              {seoData.localFaqs.map((faq, idx) => (
                <details class="faq-item card" open={idx === 0}>
                  <summary class="faq-question">
                    <span>{faq.q}</span>
                    <span class="faq-arrow">+</span>
                  </summary>
                  <div class="faq-answer">
                    <p>{faq.a}</p>
                  </div>
                </details>
              ))}
            </div>
          </div>

          <!-- Sister Cities / Nearby Service Areas -->
          {sisterCities.length > 0 && (
            <div class="sister-cities-block">
              <h3>Also Serving Communities Near {city.name}:</h3>
              <div class="sister-links-grid">
                {sisterCities.map((sister) => (
                  <a href={`/locations/${state.slug}/${sister.slug}/`} class="sister-link-card card card-sm">
                    <div class="card-body">
                      <span>📍 {sister.name}, {state.abbr}</span>
                      <span class="sister-arrow">→</span>
                    </div>
                  </a>
                ))}
              </div>
              <div class="sister-view-all">
                <a href={`/locations/${state.slug}/`}>Explore all covered cities across {state.name} →</a>
              </div>
            </div>
          )}
        </div>

        <!-- Sticky Sidebar -->
        <aside class="city-sidebar">
          <div class="sidebar-card card">
            <div class="card-body">
              <span class="sidebar-badge">{city.name} Dispatch</span>
              <h3>Speak With a Plumber Now</h3>
              <p>Get immediate help from our emergency water heater team in {city.name}.</p>

              <div class="sidebar-callout">
                <span class="sidebar-label">Local Dispatch Phone:</span>
                <a href={`tel:${siteConfig.phone}`} class="sidebar-phone">{siteConfig.phoneFormatted}</a>
                <span class="sidebar-sub">24/7 Live Operator</span>
              </div>

              <ul class="sidebar-check-list">
                <li>Same-day emergency response</li>
                <li>Upfront, guaranteed written quotes</li>
                <li>Licensed, background-checked pros</li>
                <li>Complete parts & labor warranty</li>
              </ul>

              <a href={`tel:${siteConfig.phone}`} class="btn btn-primary" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                Call For Phone Estimate
              </a>
            </div>
          </div>

          <!-- Quick Service Guarantee -->
          <div class="sidebar-card card" style="margin-top: var(--space-6);">
            <div class="card-body">
              <h4>The {siteConfig.businessName} Promise</h4>
              <p style="font-size: var(--text-sm); color: var(--color-charcoal-light); margin-bottom: var(--space-3);">
                We treat your {city.name} property with extreme care, using drop cloths and shoe covers, and leave your workspace cleaner than we found it.
              </p>
              <div class="trust-pill">✓ 100% Satisfaction Guarantee</div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Final CTA Band -->
  <section class="cta-band">
    <div class="container cta-band-inner text-center">
      <h2>Need Water Heater Service in {city.name}, {state.abbr}?</h2>
      <p>Call our local dispatch desk now for immediate support, diagnostic scheduling, or emergency repair.</p>
      <div class="cta-band-actions">
        <a href={`tel:${siteConfig.phone}`} class="btn btn-primary btn-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call {siteConfig.phoneFormatted}
        </a>
        <a href="/contact-us/" class="btn btn-secondary btn-lg">Schedule an Estimate</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Emergency Bar */
  .city-emergency-bar {
    background: #FEF3C7;
    border-bottom: 2px solid #F59E0B;
    padding-block: var(--space-3);
  }

  .emergency-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .emergency-bar-left {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .live-pulse {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-red);
    box-shadow: 0 0 0 0 rgba(196, 30, 42, 0.7);
    animation: pulse 1.8s infinite;
    flex-shrink: 0;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(196, 30, 42, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(196, 30, 42, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(196, 30, 42, 0); }
  }

  .emergency-bar-left strong {
    font-family: var(--font-heading);
    color: var(--color-navy);
    display: block;
    font-size: var(--text-base);
  }

  .emergency-bar-left span {
    font-size: var(--text-xs);
    color: var(--color-charcoal-light);
  }

  /* Layout */
  .city-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: var(--space-10);
    align-items: flex-start;
  }

  .city-lead-p {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-charcoal-light);
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  /* Zip Codes Box */
  .zips-box {
    margin-block: var(--space-8);
    background: #F0F9FF;
    border: 1px solid #BAE6FD;
  }

  .zips-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }

  .zips-icon {
    color: var(--color-orange);
  }

  .zips-header h4 {
    margin: 0;
    font-size: var(--text-base);
    color: var(--color-navy);
  }

  .zips-sub {
    font-size: var(--text-xs);
    color: var(--color-charcoal-light);
    margin-bottom: var(--space-3);
  }

  .zips-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .zip-tag {
    background: var(--color-white);
    border: 1px solid #BAE6FD;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-navy);
  }

  /* Water Profile Block */
  .water-profile-block {
    margin-bottom: var(--space-8);
    border-left: 4px solid var(--color-info);
  }

  .profile-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .water-icon {
    font-size: 2rem;
  }

  .profile-tag {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-info);
    font-weight: 700;
  }

  .profile-header h3 {
    margin: 0;
    font-size: var(--text-xl);
  }

  .profile-stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    background: var(--color-gray-50);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-4);
  }

  .p-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .p-label {
    font-size: var(--text-xs);
    color: var(--color-charcoal-light);
  }

  .p-value {
    font-size: var(--text-base);
    color: var(--color-navy);
  }

  .water-impact-text {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-charcoal);
  }

  .maintenance-box {
    background: #FFFBEB;
    border: 1px solid #FDE68A;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    margin-top: var(--space-4);
    font-size: var(--text-sm);
  }

  .maintenance-box strong {
    color: #B45309;
    display: block;
    margin-bottom: 2px;
  }

  .maintenance-box p {
    margin: 0;
    color: var(--color-charcoal);
  }

  /* Code Block */
  .code-block {
    margin-bottom: var(--space-8);
    border-left: 4px solid var(--color-success);
  }

  .code-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .code-icon {
    font-size: 2rem;
  }

  .code-text {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .code-checklist {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .code-checklist li::before {
    content: "✓ ";
    color: var(--color-success);
    font-weight: 700;
    margin-right: var(--space-2);
  }

  /* Diagnostic Matrix */
  .diagnostic-card {
    margin-block: var(--space-6);
  }

  .table-responsive {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .diag-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-xs);
    text-align: left;
  }

  .diag-table th {
    background: var(--color-navy);
    color: #fff;
    padding: var(--space-3);
    font-weight: 700;
    white-space: nowrap;
  }

  .diag-table td {
    padding: var(--space-3);
    border-bottom: 1px solid var(--color-gray-200);
    line-height: 1.5;
    vertical-align: top;
  }

  .diag-table tr:nth-child(even) td {
    background: var(--color-gray-50);
  }

  .diag-table code {
    background: #e9ecef;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    color: #0c5460;
  }

  /* Pricing Block */
  .pricing-block {
    margin-bottom: var(--space-8);
  }

  .pricing-note {
