---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import StatesGrid from '../components/StatesGrid.astro';
import siteConfig from '../data/site-config.json';
import testimonialsData from '../data/testimonials.json';

const reviews = testimonialsData.reviews.slice(0, 6);

const commonProblems = [
  {
    title: 'No Hot Water',
    desc: 'Faulty heating elements, bad thermostats, or pilot light issues resolved rapidly.',
    icon: '❄️'
  },
  {
    title: 'Leaking Water Heater',
    desc: 'Pressure valves, drain valves, or tank fractures inspected and repaired or replaced.',
    icon: '💧'
  },
  {
    title: 'Strange Popping Noises',
    desc: 'Mineral and sediment buildup at the tank bottom flushed and descaled safely.',
    icon: '🔊'
  },
  {
    title: 'Rusty or Discolored Water',
    desc: 'Corroded sacrificial anode rods diagnosed and replaced before tank failure.',
    icon: '🧪'
  },
  {
    title: 'Pilot Light Won\'t Light',
    desc: 'Thermocouple, gas control valve, and burner assembly diagnostics and repair.',
    icon: '🔥'
  },
  {
    title: 'Inadequate or Tepid Water',
    desc: 'Undersized units, dip tube failures, or partial element burnout corrected.',
    icon: '⚡'
  }
];

const faqs = [
  {
    q: 'How quickly can a technician arrive for an emergency repair?',
    a: 'In most service areas, our licensed technicians can arrive within 45 to 90 minutes. We operate 24 hours a day, 7 days a week, including weekends and holidays.'
  },
  {
    q: 'Should I repair or replace my water heater?',
    a: 'As a rule of thumb: if your water heater is under 8-10 years old and the repair cost is less than 50% of a new unit, repair is usually best. If it is over 10-12 years old, leaking from the tank itself, or repeatedly breaking down, replacement is typically the most cost-effective solution.'
  },
  {
    q: 'How do I get an estimate for my repair or replacement?',
    a: 'We provide upfront estimates directly over the phone based on your equipment symptoms. Call our 24/7 hotline at (833) 895-0968 to discuss your needs with a specialist.'
  },
  {
    q: 'Are your plumbers licensed and insured?',
    a: 'Every technician in our network is fully licensed, insured, and background-checked, adhering strictly to local plumbing codes and manufacturer specifications.'
  },
  {
    q: 'What types and brands of water heaters do you service?',
    a: 'We service all major fuel types (gas, electric, tankless, hybrid heat pump) and all top manufacturers, including Rheem, Bradford White, A.O. Smith, Rinnai, Navien, State, and Bosch.'
  }
];

const homeSchema = {
  "@context": "https://schema.org",
  "@type": "PlumbingService",
  "name": siteConfig.businessName,
  "telephone": siteConfig.phone,
  "url": siteConfig.domain,
  "image": `${siteConfig.domain}/images/logo.png`,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteConfig.address.street,
    "addressLocality": siteConfig.address.city,
    "addressRegion": siteConfig.address.state,
    "postalCode": siteConfig.address.zip,
    "addressCountry": siteConfig.address.country
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
    "opens": "00:00",
    "closes": "23:59"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<BaseLayout
  title={`${siteConfig.businessName} — 24/7 Emergency Water Heater Repair & Installation`}
  description="Fast, reliable water heater repair and replacement services across the nation. Gas, electric, and tankless specialists available 24/7. Call now for an upfront estimate!"
  jsonLd={[homeSchema, faqSchema]}
>
  <!-- Hero Section -->
  <Hero
    title="Fast Water Heater Repair & Installation"
    subtitle="From cold showers to emergency leaks, our licensed technicians are ready 24/7 to restore your hot water fast with upfront, honest pricing."
    showCtas={true}
    variant="full"
    backgroundImage="/images/hero.jpg"
  />

  <!-- Trust Badges Strip -->
  <TrustStrip />

  <!-- Emergency Banner Strip -->
  <section class="emergency-strip">
    <div class="container emergency-inner">
      <div class="emergency-text">
        <span class="emergency-pulse"></span>
        <div>
          <strong>Water Heater Leaking or Completely Cold?</strong>
          <p>Don't let water damage ruin your home. Emergency technicians are on standby right now.</p>
        </div>
      </div>
      <a href={`tel:${siteConfig.phone}`} class="btn btn-primary btn-lg emergency-call-btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Call {siteConfig.phoneFormatted}
      </a>
    </div>
  </section>

  <!-- Comprehensive Services Section -->
  <section class="section">
    <div class="container">
      <div class="text-center">
        <span class="badge badge-navy">Our Expertise</span>
        <h2 class="section-title">Complete Water Heater Services</h2>
        <p class="section-subtitle">
          Whether you have an electric tank, energy-efficient gas model, or high-tech tankless unit, our certified plumbers have the parts and expertise to solve your issue.
        </p>
      </div>

      <ServicesGrid />

      <div class="text-center" style="margin-top: var(--space-8);">
        <a href="/services/" class="btn btn-outline">Explore All Services & Estimating Guide →</a>
      </div>
    </div>
  </section>

  <!-- Visual Technology Showcase -->
  <section class="section" style="background-color: var(--color-gray-50);">
    <div class="container">
      <div class="text-center" style="margin-bottom: var(--space-8);">
        <span class="badge badge-orange">Master Craftsmanship</span>
        <h2 class="section-title">Field-Tested Water Heating Solutions</h2>
        <p class="section-subtitle">
          From modern space-saving tankless conversions to component-level electronic troubleshooting, our master plumbers bring factory-certified expertise to every call.
        </p>
      </div>

      <div class="grid grid-2" style="gap: var(--space-8);">
        <!-- Tankless Showcase Card -->
        <div class="card" style="overflow: hidden;">
          <img src="/images/tankless.jpg" alt="High efficiency wall-mounted tankless water heater installation" loading="lazy" style="width: 100%; height: 260px; object-fit: cover; display: block;" />
          <div class="card-body">
            <span class="badge badge-navy">Continuous Hot Water</span>
            <h3 style="margin-block: var(--space-2) var(--space-3);">High-Efficiency On-Demand Tankless Systems</h3>
            <p style="font-size: var(--text-sm); color: var(--color-charcoal-light); line-height: 1.6; margin-bottom: var(--space-4);">
              Slash monthly gas utility costs by eliminating standby heat loss. Our certified installers handle gas line sizing, direct-vent flue exhaust, and annual descaling service.
            </p>
            <a href="/services/tankless-water-heater-installation/" class="btn btn-outline btn-sm">Explore Tankless Solutions →</a>
          </div>
        </div>

        <!-- Component Diagnostics Showcase Card -->
        <div class="card" style="overflow: hidden;">
          <img src="/images/repair.jpg" alt="Plumbing technician testing thermostat and heating elements" loading="lazy" style="width: 100%; height: 260px; object-fit: cover; display: block;" />
          <div class="card-body">
            <span class="badge badge-orange">Precision Repairs</span>
            <h3 style="margin-block: var(--space-2) var(--space-3);">Component Diagnostics & Element Rebuilds</h3>
            <p style="font-size: var(--text-sm); color: var(--color-charcoal-light); line-height: 1.6; margin-bottom: var(--space-4);">
              We test heating elements with digital multimeters, clear pilot assemblies, test thermocouples, and replace sacrificial anode rods to restore safe operation fast.
            </p>
            <a href="/services/emergency-water-heater-repair/" class="btn btn-outline btn-sm">Learn About Repairs →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Common Problems We Solve -->
  <section class="section" style="background-color: var(--color-white);">
    <div class="container">
      <div class="text-center">
        <span class="badge badge-orange">Fast Diagnostics</span>
        <h2 class="section-title">Common Water Heater Issues We Fix</h2>
        <p class="section-subtitle">
          Notice any of these warning signs? Don't wait until a small issue turns into a catastrophic tank rupture.
        </p>
      </div>

      <div class="problems-grid">
        {commonProblems.map((prob) => (
          <div class="problem-card card card-sm">
            <div class="card-body">
              <span class="problem-icon">{prob.icon}</span>
              <h3 class="problem-title">{prob.title}</h3>
              <p class="problem-desc">{prob.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="section why-us-section">
    <div class="container">
      <div class="why-us-layout">
        <div class="why-us-content">
          <span class="badge badge-red">Why HotWater Rescue</span>
          <h2>The Trusted Choice for Water Heater Repairs Nationwide</h2>
          <p class="lead-text">
            When you're dealing with ice-cold showers or a flooded utility room, you need an honest, capable team that treats your home with respect and solves the problem right the first time.
          </p>

          <div class="perks-list">
            <div class="perk-item">
              <div class="perk-icon">✓</div>
              <div>
                <strong>Same-Day & 24/7 Emergency Response</strong>
                <p>Day or night, our dispatch team connects you with an available local technician ready to assist.</p>
              </div>
            </div>
            <div class="perk-item">
              <div class="perk-icon">✓</div>
              <div>
                <strong>Upfront Pricing With Zero Hidden Fees</strong>
                <p>You'll receive a transparent, clear quote before work begins, so you're never surprised by your bill.</p>
              </div>
            </div>
            <div class="perk-item">
              <div class="perk-icon">✓</div>
              <div>
                <strong>Fully Licensed, Vetted & Insured Pros</strong>
                <p>All plumbing professionals adhere to state and municipal building codes for complete safety.</p>
              </div>
            </div>
            <div class="perk-item">
              <div class="perk-icon">✓</div>
              <div>
                <strong>Warranty on Parts & Workmanship</strong>
                <p>We stand behind our repairs and installations with industry-leading warranties on both parts and labor.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="why-us-card card">
          <div class="card-body">
            <div class="card-badge">Instant Assistance</div>
            <h3>Need Water Heater Help Today?</h3>
            <p>Speak directly with our friendly dispatch team. We can diagnose your symptoms over the phone and book a licensed plumber.</p>
            
            <div class="callout-box">
              <span class="callout-label">Emergency Hotline:</span>
              <a href={`tel:${siteConfig.phone}`} class="callout-phone">{siteConfig.phoneFormatted}</a>
              <span class="callout-note">Lines open 24 hours / 365 days a year</span>
            </div>

            <ul class="check-features">
              <li>Over-the-phone troubleshooting & estimates</li>
              <li>Same-day service slots available</li>
              <li>Repair & replacement on all major brands</li>
            </ul>

            <a href="/contact-us/" class="btn btn-primary" style="width: 100%;">Schedule Service</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Nationwide Coverage / States Grid -->
  <section class="section" id="coverage">
    <div class="container">
      <div class="text-center">
        <span class="badge badge-navy">Nationwide Service Areas</span>
        <h2 class="section-title">Licensed Water Heater Pros in All 50 States</h2>
        <p class="section-subtitle">
          From major metropolitan centers to suburban communities, our network covers over 14,000 cities across America. Select your state below to find local technicians:
        </p>
      </div>

      <StatesGrid />

      <div class="text-center" style="margin-top: var(--space-8);">
        <a href="/locations/" class="btn btn-outline">View Complete Nationwide Location Directory →</a>
      </div>
    </div>
  </section>

  <!-- Customer Testimonials -->
  <section class="section" style="background-color: var(--color-white);">
    <div class="container">
      <div class="text-center">
        <span class="badge badge-orange">Customer Feedback</span>
        <h2 class="section-title">Real Reviews From Real Homeowners</h2>
        <p class="section-subtitle">
          Discover why thousands of homeowners count on HotWater Rescue when their hot water systems go down.
        </p>
      </div>

      <div class="reviews-grid">
        {reviews.map((rev) => (
          <div class="review-card card">
            <div class="card-body">
              <div class="stars" aria-label="5 out of 5 stars">
                ★★★★★
              </div>
              <p class="review-text">"{rev.text}"</p>
              <div class="review-meta">
                <strong>Homeowner</strong>
                <span class="review-loc">{rev.location}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section">
    <div class="container container-narrow">
      <div class="text-center">
        <span class="badge badge-navy">Got Questions?</span>
        <h2 class="section-title">Frequently Asked Questions</h2>
        <p class="section-subtitle">
          Answers to common questions about water heater repair, replacement timelines, costs, and emergency coverage.
        </p>
      </div>

      <div class="faq-list">
        {faqs.map((faq, index) => (
          <details class="faq-item card" open={index === 0}>
            <summary class="faq-question">
              <span>{faq.q}</span>
              <span class="faq-arrow">+</span>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final Call to Action Strip -->
  <section class="cta-band">
    <div class="container cta-band-inner text-center">
      <span class="cta-mini-tag">Don't Suffer Through Another Cold Shower</span>
      <h2>Get Fast Water Heater Repair Today</h2>
      <p>Contact our team now for an immediate response, upfront quote, and certified repair technician.</p>
      <div class="cta-band-actions">
        <a href={`tel:${siteConfig.phone}`} class="btn btn-primary btn-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call {siteConfig.phoneFormatted}
        </a>
        <a href="/contact-us/" class="btn btn-secondary btn-lg">Request an Estimate Online</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Emergency Strip */
  .emergency-strip {
    background: #FFF3E0;
    border-bottom: 2px solid var(--color-orange);
    padding-block: var(--space-4);
  }

  .emergency-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .emergency-text {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .emergency-pulse {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-red);
    box-shadow: 0 0 0 0 rgba(196, 30, 42, 0.7);
    animation: pulse 1.8s infinite;
    flex-shrink: 0;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(196, 30, 42, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(196, 30, 42, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(196, 30, 42, 0); }
  }

  .emergency-text strong {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-navy);
    display: block;
  }

  .emergency-text p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-charcoal-light);
  }

  .emergency-call-btn {
    flex-shrink: 0;
  }

  /* Common Problems Grid */
  .problems-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .problem-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: var(--space-3);
  }

  .problem-title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .problem-desc {
    font-size: var(--text-sm);
    color: var(--color-charcoal-light);
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  /* Why Us Section */
  .why-us-section {
    background: linear-gradient(180deg, var(--color-offwhite) 0%, rgba(27, 42, 74, 0.04) 100%);
  }

  .why-us-layout {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .lead-text {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-charcoal-light);
    margin-top: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .perks-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .perk-item {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .perk-icon {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-full);
    background: var(--color-success);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: var(--text-sm);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .perk-item strong {
    font-size: var(--text-base);
    color: var(--color-navy);
    display: block;
    margin-bottom: 2px;
  }

  .perk-item p {
    font-size: var(--text-sm);
    color: var(--color-charcoal-light);
    margin: 0;
  }

  .why-us-card {
    border: 2px solid rgba(27, 42, 74, 0.08);
  }

  .why-us-card .card-body {
    padding: var(--space-8);
  }

  .card-badge {
    display: inline-block;
    background: rgba(232, 97, 26, 0.12);
    color: var(--color-orange);
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-3);
  }

  .callout-box {
    background: var(--color-navy);
    color: var(--color-white);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    text-align: center;
    margin-block: var(--space-5);
  }

  .callout-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    opacity: 0.8;
    display: block;
    margin-bottom: var(--space-1);
  }

  .callout-phone {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-orange);
    display: block;
    margin-bottom: var(--space-1);
  }

  .callout-note {
    font-size: var(--text-xs);
    opacity: 0.75;
  }

  .check-features {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-charcoal);
  }

  .check-features li::before {
    content: "✓ ";
    color: var(--color-success);
    font-weight: bold;
    margin-right: var(--space-2);
  }

  /* Reviews Grid */
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .review-card .card-body {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .stars {
    color: #F59E0B;
    font-size: 1.25rem;
    letter-spacing: 2px;
    margin-bottom: var(--space-3);
  }

  .review-text {
    font-size: var(--text-sm);
    color: var(--color-charcoal);
    line-height: var(--leading-relaxed);
    font-style: italic;
    margin-bottom: var(--space-5);
    flex-grow: 1;
  }

  .review-meta {
    border-top: 1px solid var(--color-gray-200);
    padding-top: var(--space-3);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--text-xs);
  }

  .review-loc {
    color: var(--color-charcoal-light);
  }

  /* FAQ Styles */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .faq-item {
    cursor: pointer;
  }

  .faq-question {
    padding: var(--space-5) var(--space-6);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--color-navy);
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-arrow {
    font-size: 1.5rem;
    font-weight: 300;
    color: var(--color-orange);
    transition: transform var(--transition-fast);
  }

  details[open] .faq-arrow {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 var(--space-6) var(--space-6);
    color: var(--color-charcoal-light);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  /* CTA Band */
  .cta-band {
    background: var(--color-navy);
    color: var(--color-white);
    padding-block: var(--space-20);
  }

  .cta-mini-tag {
    color: var(--color-orange);
    font-weight: 700;
    text-transform: uppercase;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    display: block;
    margin-bottom: var(--space-2);
  }

  .cta-band h2 {
    color: var(--color-white);
    font-size: var(--text-4xl);
    margin-bottom: var(--space-3);
  }

  .cta-band p {
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--text-lg);
    max-width: 600px;
    margin-inline: auto;
    margin-bottom: var(--space-8);
  }

