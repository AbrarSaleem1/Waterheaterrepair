---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import siteConfig from '../../data/site-config.json';
import blogs from '../../data/blogs.json';

const categories = Array.from(new Set(blogs.map(b => b.category)));

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Blog' }
];

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": `${siteConfig.businessName} Professional Water Heater Knowledge Base`,
  "description": "28 in-depth homeowner advice guides, maintenance protocols, emergency troubleshooting instructions, and equipment comparison from master licensed plumbers.",
  "url": `${siteConfig.domain}/blog/`,
  "publisher": {
    "@type": "Organization",
    "name": siteConfig.businessName,
    "url": siteConfig.domain
  }
};
---

<BaseLayout
  title={`28 Expert Water Heater Guides, Maintenance & Troubleshooting | ${siteConfig.businessName}`}
  description="Comprehensive 28-article plumbing library covering gas, electric, and tankless water heaters. Diagnostics, anode rod maintenance, code compliance, and emergency procedures."
  breadcrumbs={breadcrumbs}
  jsonLd={blogSchema}
>
  <Hero
    title="Master Plumber Knowledge Base"
    subtitle={`Explore 28 in-depth technical guides, safety checklists, and diagnostic walkthroughs authored by licensed master plumbers.`}
    breadcrumbs={breadcrumbs}
    variant="short"
  />

  <TrustStrip />

  <!-- Blog Posts Grid -->
  <section class="section">
    <div class="container">
      <div class="text-center" style="margin-bottom: var(--space-8);">
        <span class="badge badge-navy">28 Certified Articles</span>
        <h2 class="section-title">Complete Water Heater Guides & Troubleshooting Library</h2>
        <p class="section-subtitle">
          Search our field-tested diagnostic procedures, code compliance guides, and preventative maintenance strategies.
        </p>

        <!-- Category Filter Pills -->
        <div class="category-pills">
          <span class="pill pill-active">All Categories ({blogs.length})</span>
          {categories.map((cat) => (
            <span class="pill">{cat}</span>
          ))}
        </div>
      </div>

      <div class="blog-grid">
        {blogs.map((post) => (
          <article class="blog-card card">
            <div class="card-body">
              <div class="blog-meta">
                <span class="blog-cat badge badge-orange">{post.category}</span>
                <span class="blog-read">{post.readTime}</span>
              </div>
              <h3 class="blog-title">
                <a href={`/blog/${post.slug}/`}>{post.title}</a>
              </h3>
              <p class="blog-snippet">{post.snippet}</p>
              <div class="blog-footer">
                <span class="blog-date">📅 {post.date}</span>
                <a href={`/blog/${post.slug}/`} class="blog-action">
                  Read Full Guide →
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="cta-band">
    <div class="container cta-band-inner text-center">
      <h2>Need Immediate In-Person Help?</h2>
      <p>If DIY troubleshooting didn't resolve your issue, our licensed master technicians are on call 24/7 across the nation.</p>
      <div class="cta-band-actions">
        <a href={`tel:${siteConfig.phone}`} class="btn btn-primary btn-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call {siteConfig.phoneFormatted}
        </a>
        <a href="/contact-us/" class="btn btn-secondary btn-lg">24/7 Phone Estimate Desk</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .category-pills {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }

  .pill {
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    background: var(--color-gray-100);
    color: var(--color-charcoal);
    cursor: default;
    transition: background 0.2s;
  }

  .pill-active {
    background: var(--color-navy);
    color: #fff;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .blog-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .blog-read {
    font-size: var(--text-xs);
    color: var(--color-charcoal-light);
  }

  .blog-title {
    font-size: var(--text-lg);
    line-height: 1.35;
    margin-bottom: var(--space-3);
  }

  .blog-title a {
    color: var(--color-navy);
    text-decoration: none;
    transition: color 0.2s;
  }

  .blog-title a:hover {
    color: var(--color-orange);
  }

  .blog-snippet {
    font-size: var(--text-sm);
    color: var(--color-charcoal-light);
    line-height: 1.6;
    margin-bottom: var(--space-6);
    flex-grow: 1;
  }

  .blog-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--color-gray-200);
    padding-top: var(--space-3);
    margin-top: auto;
  }

  .blog-date {
    font-size: var(--text-xs);
    color: var(--color-charcoal-light);
  }

  .blog-action {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-orange);
    text-decoration: none;
  }

  .blog-action:hover {
    text-decoration: underline;
  }

  @media (max-width: 1024px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
