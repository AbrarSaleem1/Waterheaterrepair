---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import siteConfig from '../../data/site-config.json';
import services from '../../data/services.json';

export async function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

// Rich detail mappings for each service
const serviceDetails: Record<string, {
  tagline: string;
  symptoms: string[];
  processSteps: { title: string; desc: string }[];
  costRange: string;
  duration: string;
  faqs: { q: string; a: string }[];
}> = {
  'electric-water-heater-repair': {
    tagline: 'Reliable repair for heating elements, upper & lower thermostats, wiring, and circuit breakers.',
    symptoms: [
      'Water is completely cold or barely lukewarm',
      'Hot water runs out much faster than usual',
      'Breaker trips repeatedly whenever the water heater turns on',
      'Water temperature fluctuates wildly throughout the day',
      'Hissing or humming noises originating from the tank'
    ],
    processSteps: [
      { title: 'Electrical Safety & Power Diagnostic', desc: 'We verify 240V power supply at the junction box and inspect breaker panel connections.' },
      { title: 'Heating Element Continuity Test', desc: 'Using a digital multimeter, we test the resistance of both upper and lower heating elements.' },
      { title: 'Dual Thermostat Inspection', desc: 'We inspect both upper and lower thermostats, high-limit reset buttons, and wiring harnesses.' },
      { title: 'Component Replacement & Re-Testing', desc: 'We replace damaged elements or thermostats with heavy-duty OEM parts, refill the tank, and test recovery rate.' }
    ],
    duration: '1 – 2 Hours',
    faqs: [
      { q: 'Why is my electric water heater producing only lukewarm water?', a: 'This is usually caused by a burned-out upper or lower heating element. When one element fails, the unit can only heat a fraction of the tank.' },
      { q: 'Can I replace an electric water heater element myself?', a: 'Working with 240-volt electrical circuits and pressurized water carries high risk of electrocution or dry-firing the new element. Hiring a licensed technician ensures safety and warranty coverage.' },
      { q: 'How often should electric water heater elements be replaced?', a: 'In areas with hard water, elements can suffer scale buildup and burn out every 3 to 6 years. With water softening or periodic flushing, they can last 8 to 10 years.' }
    ]
  },
  'gas-water-heater-repair': {
    tagline: 'Certified gas technicians servicing pilot lights, thermocouples, gas valves, and burner assemblies safely.',
    symptoms: [
      'Pilot light refuses to stay lit or goes out repeatedly',
      'Burner produces yellow or sooty flames instead of crisp blue',
      'Strong odor of gas or rotten eggs (requires immediate emergency shutoff)',
      'No hot water or inconsistent water temperature',
      'Popping, rumbling sounds coming from the burner chamber'
    ],
    processSteps: [
      { title: 'Gas Leak & Ventilation Safety Inspection', desc: 'We check gas lines for leaks with electronic detectors and ensure the draft hood is venting combustion gases safely.' },
      { title: 'Thermocouple & Pilot Assembly Check', desc: 'We inspect the thermocouple millivolt output, clean the pilot orifice, and verify flame sensor operation.' },
      { title: 'Gas Control Valve Diagnostics', desc: 'We test the thermostat sensor tube and gas control valve regulator to verify proper gas delivery to the burner.' },
      { title: 'Burner Cleaning & Calibration', desc: 'We clean the main burner ports, inspect the flame arrestor screen, and test the combustion flame color.' }
    ],
    duration: '1 – 2.5 Hours',
    faqs: [
      { q: 'What should I do if I smell gas near my water heater?', a: 'Evacuate the home immediately, leave the door open, avoid flipping light switches, and call your local gas utility or 911 from a safe distance outside.' },
      { q: 'Why does my pilot light keep extinguishing?', a: 'The most common cause is a dirty or defective thermocouple, followed by a clogged pilot tube, drafts in the utility room, or a failing gas control valve.' },
      { q: 'How often should a gas water heater burner be cleaned?', a: 'We recommend inspecting and cleaning the burner chamber and intake screen annually to maintain combustion efficiency and prevent carbon monoxide hazards.' }
    ]
  },
  'tankless-water-heater-installation': {
    tagline: 'Endless on-demand hot water, superior energy savings, and expert descaling maintenance.',
    symptoms: [
      'Error codes displayed on the digital control screen (e.g., Code 11, 12, or 29)',
      'Water alternates between hot and cold ("cold water sandwich")',
      'Reduced water flow rate when multiple fixtures are in use',
      'Unit shuts down during mid-shower due to exhaust blockage',
      'Mineral scale buildup inside the copper or stainless heat exchanger'
    ],
    processSteps: [
      { title: 'Sizing & Demand Calculation', desc: 'We calculate peak simultaneous Gallons Per Minute (GPM) demand and local groundwater temperature rise.' },
      { title: 'Gas Line & Electrical Evaluation', desc: 'We verify appropriate gas line pipe diameter (typically 3/4" for 150k-199k BTU) and dedicated electrical circuit.' },
      { title: 'Direct Vent & Condensate Piping', desc: 'We install concentric PVC or polypropylene venting to the exterior and route acidic condensate safely.' },
      { title: 'Isolation Valves & Descaling Setup', desc: 'We install full-port service isolation valves for fast future vinegar descaling maintenance.' }
    ],
    duration: '4 – 6 Hours',
    faqs: [
      { q: 'How much energy does a tankless water heater actually save?', a: 'According to the US Department of Energy, tankless water heaters can be 24% to 34% more energy-efficient than conventional storage tank heaters for homes using 41 gallons or less of hot water daily.' },
      { q: 'How often does a tankless unit need to be descaled?', a: 'In standard water conditions, annual flushing with a non-toxic food-grade descaling solution is required to keep the manufacturer warranty valid and preserve heat exchange efficiency.' },
      { q: 'Can a tankless water heater run out of hot water?', a: 'No! Tankless heaters heat water continuously as it passes through the unit. As long as your demand does not exceed the unit\'s maximum flow rate (GPM), you will have hot water endlessly.' }
    ]
  },
  'water-heater-replacement': {
    tagline: 'Complete replacement with professional removal of old unit, code-compliant install, and warranty.',
    symptoms: [
      'The storage tank is leaking from the bottom seam or base',
      'The water heater is more than 10 to 12 years old',
      'Visible rust or rust-colored water coming from hot water taps',
      'Frequent repairs that cost more than 50% of a brand-new unit',
      'Outdated unit failing to meet current home energy efficiency standards'
    ],
    processSteps: [
      { title: 'Old Unit Drainage & Safe Disconnection', desc: 'We shut off the water and fuel supply, fully drain the tank sediment, and disconnect gas, electric, and flue piping.' },
      { title: 'Haul-Away & Environmentally Responsible Disposal', desc: 'We safely transport and dispose of your old tank according to local municipal recycling regulations.' },
      { title: 'New Unit Placement & Seismic / Pan Setup', desc: 'We place the new tank on an insulated stand with a safety drain pan and seismic safety straps if required by code.' },
      { title: 'Plumbing Connections & Expansion Tank', desc: 'We install brand-new dielectric unions, brass ball shutoff valve, thermal expansion tank, and test under full pressure.' }
    ],
    duration: '3 – 4 Hours',
    faqs: [
      { q: 'How long does a water heater replacement take?', a: 'Most standard tank replacements take between 3 to 4 hours from arrival to final hot water testing.' },
      { q: 'What brand of water heaters do you install?', a: 'We install top-rated commercial-grade brands including Rheem, Bradford White, A.O. Smith, Rinnai, and Navien.' },
      { q: 'Do you haul away the old water heater?', a: 'Yes! Safe disconnection, removal, and eco-friendly disposal of the old water heater is included in all replacement jobs.' }
    ]
  },
  'commercial-water-heater-services': {
    tagline: 'Heavy-duty commercial water heating systems for restaurants, hotels, apartment complexes, and office facilities.',
    symptoms: [
      'Inadequate hot water during peak business operating hours',
      'Health department compliance failure due to low sanitization rinse temps',
      'Commercial storage tank leaking or showing external corrosion',
      'Boiler loop or recirculating pump failure',
      'Excessive utility bills caused by inefficient commercial burners'
    ],
    processSteps: [
      { title: 'Facility Commercial Load Assessment', desc: 'We calculate fixture unit count, sanitization temperature requirements (180°F for commercial dishwashers), and peak recovery demands.' },
      { title: 'Code Compliance & Permitting', desc: 'We verify ASME vessel requirements, commercial gas line capacity, and local commercial plumbing codes.' },
      { title: 'High-Output System Installation', desc: 'We install multi-unit staged water heaters or commercial tankless arrays with redundant backup failover.' },
      { title: 'Circulation Pump & Balancing', desc: 'We calibrate high-volume return circulation loops for instant hot water delivery across multi-story buildings.' }
    ],
    duration: 'Same-Day Commercial Emergency Response',
    faqs: [
      { q: 'Do you offer emergency service for commercial facilities?', a: 'Yes. We understand that a restaurant or hotel without hot water cannot legally operate. We provide priority emergency dispatch 24/7/365.' },
      { q: 'Can you maintain commercial recirculation pumps and mixing valves?', a: 'Absolutely. We service and install commercial digital mixing valves, booster heaters, and commercial recirculation pumps.' },
      { q: 'Do you service multi-unit apartment complexes?', a: 'Yes, we handle central boiler loop systems, multi-tank banks, and individual tenant water heater change-outs.' }
    ]
  }
};

const details = serviceDetails[service.slug] || {
  tagline: service.shortDescription,
  symptoms: ['Inconsistent hot water', 'Strange noises', 'Leaks near tank', 'High utility bills'],
  processSteps: [
    { title: 'Diagnostic Inspection', desc: 'Thorough evaluation of all electrical and mechanical components.' },
    { title: 'Repair or Replacement', desc: 'Fast execution using code-compliant replacement parts.' }
  ],
  duration: '1 – 3 Hours',
  faqs: []
};

const otherServices = services.filter(s => s.slug !== service.slug);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: service.shortName }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.name,
  "serviceType": service.name,
  "description": service.metaDescription,
  "provider": {
    "@type": "PlumbingService",
    "name": siteConfig.businessName,
    "telephone": siteConfig.phone,
    "url": siteConfig.domain
  },
  "areaServed": "United States"
};
---

<BaseLayout
  title={service.metaTitle}
  description={service.metaDescription}
  breadcrumbs={breadcrumbs}
  jsonLd={serviceSchema}
>
  <Hero
    title={service.name}
    subtitle={details.tagline}
    breadcrumbs={breadcrumbs}
    variant="short"
    backgroundImage="/images/hero.jpg"
  />

  <TrustStrip />

  <!-- Main Service Content -->
  <section class="section">
    <div class="container">
      <div class="service-layout">
        <div class="service-content">
          <span class="badge badge-navy">Service Overview</span>
          <h2>Professional {service.shortName}</h2>
          <p class="service-lead">{service.shortDescription}</p>
          <p>
            When your water heater fails, life grinds to a halt. At {siteConfig.businessName}, our certified technicians arrive with fully-stocked service vehicles equipped with commercial-grade parts to diagnose and fix {service.name.toLowerCase()} on the very first visit.
          </p>

          <!-- Service Illustration Card -->
          <div class="card" style="overflow: hidden; margin-block: var(--space-6);">
            <img 
              src={service.id === 'tankless-water-heater-installation' ? '/images/tankless.jpg' : '/images/repair.jpg'} 
              alt={`${service.name} field service`} 
              loading="lazy" 
              style="width: 100%; height: 260px; object-fit: cover; display: block;" 
            />
            <div class="card-body" style="padding: var(--space-3) var(--space-4); background: var(--color-gray-50);">
              <span style="font-size: var(--text-xs); color: var(--color-charcoal-light);">
                📸 <em>Certified master technician performing {service.shortName.toLowerCase()} with commercial-grade tooling and safety testing.</em>
              </span>
            </div>
          </div>

          <!-- Symptoms Section -->
          <div class="service-block">
            <h3>Signs You Need {service.shortName}</h3>
            <ul class="symptoms-list">
              {details.symptoms.map((symptom) => (
                <li>
                  <span class="bullet-icon">⚠️</span>
                  <span>{symptom}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Step by Step Process -->
          <div class="service-block">
            <h3>Our Diagnostic & Repair Process</h3>
            <div class="process-steps">
              {details.processSteps.map((step, idx) => (
                <div class="step-card">
                  <div class="step-num">{idx + 1}</div>
                  <div class="step-info">
                    <h4>{step.title}</h4>
                    <p>{step.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- FAQs Section -->
          {details.faqs.length > 0 && (
            <div class="service-block">
              <h3>Frequently Asked Questions About {service.shortName}</h3>
              <div class="faq-list">
                {details.faqs.map((faq, idx) => (
                  <details class="faq-item card" open={idx === 0}>
                    <summary class="faq-question">
                      <span>{faq.q}</span>
                      <span class="faq-arrow">+</span>
                    </summary>
                    <div class="faq-answer">
                      <p>{faq.a}</p>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <aside class="service-sidebar">
          <div class="sidebar-card card">
            <div class="card-body">
              <span class="sidebar-badge">Fast Service</span>
              <h3>Need Fast Help?</h3>
              <p>Speak to our dispatch team right now. We provide free troubleshooting and upfront estimates.</p>
              
              <div class="sidebar-callout">
                <span class="sidebar-label">Direct Phone:</span>
                <a href={`tel:${siteConfig.phone}`} class="sidebar-phone">{siteConfig.phoneFormatted}</a>
                <span class="sidebar-sub">24/7 Emergency Line</span>
              </div>

              <div class="sidebar-meta">
                <div class="meta-row">
                  <span class="meta-label">Estimate:</span>
                  <span class="meta-value">Available by Phone</span>
                </div>
                <div class="meta-row">
                  <span class="meta-label">Est. Duration:</span>
                  <span class="meta-value">{details.duration}</span>
                </div>
                <div class="meta-row">
                  <span class="meta-label">Warranty:</span>
                  <span class="meta-value">Parts & Labor Included</span>
                </div>
              </div>

              <a href={`tel:${siteConfig.phone}`} class="btn btn-primary" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                Call For Phone Estimate
              </a>
            </div>
          </div>

          <!-- Other Services Menu -->
          <div class="sidebar-card card" style="margin-top: var(--space-6);">
            <div class="card-body">
              <h4>Other Services</h4>
              <ul class="other-services-list">
                {otherServices.map((other) => (
                  <li>
                    <a href={`/services/${other.slug}/`}>
                      <span>{other.shortName}</span>
                      <span class="link-arrow">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="cta-band">
    <div class="container cta-band-inner text-center">
      <h2>Ready to Restore Your Hot Water?</h2>
      <p>Our licensed technicians are ready 24/7 to solve your water heater issues with guaranteed satisfaction.</p>
      <div class="cta-band-actions">
        <a href={`tel:${siteConfig.phone}`} class="btn btn-primary btn-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call {siteConfig.phoneFormatted}
        </a>
        <a href="/contact-us/" class="btn btn-secondary btn-lg">Request an Estimate</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .service-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: var(--space-10);
    align-items: flex-start;
  }

  .service-lead {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-charcoal-light);
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .service-block {
    margin-top: var(--space-10);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-gray-200);
  }

  .service-block h3 {
    margin-bottom: var(--space-6);
  }

  .symptoms-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .symptoms-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    background: var(--color-white);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    font-size: var(--text-base);
  }

  .bullet-icon {
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .process-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .step-card {
    display: flex;
    gap: var(--space-4);
    background: var(--color-white);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  .step-num {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-full);
    background: var(--color-navy);
    color: var(--color-white);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .step-info h4 {
    margin-bottom: var(--space-1);
    font-size: var(--text-lg);
  }

  .step-info p {
    font-size: var(--text-sm);
    color: var(--color-charcoal-light);
    margin: 0;
  }

  /* FAQ Accordion */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-question {
    padding: var(--space-4) var(--space-5);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-base);
    color: var(--color-navy);
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-arrow {
    color: var(--color-orange);
    font-size: 1.3rem;
  }

  details[open] .faq-arrow {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 var(--space-5) var(--space-4);
    color: var(--color-charcoal-light);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  /* Sidebar */
  .sidebar-badge {
    display: inline-block;
    background: rgba(232, 97, 26, 0.12);
    color: var(--color-orange);
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-3);
  }

  .sidebar-callout {
    background: var(--color-navy);
    color: var(--color-white);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    text-align: center;
    margin-block: var(--space-4);
  }

  .sidebar-label {
    font-size: var(--text-xs);
    opacity: 0.8;
    display: block;
  }

  .sidebar-phone {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-orange);
    display: block;
  }

  .sidebar-sub {
    font-size: var(--text-xs);
    opacity: 0.7;
  }

  .sidebar-meta {
    border-top: 1px solid var(--color-gray-200);
    border-bottom: 1px solid var(--color-gray-200);
    padding-block: var(--space-3);
    margin-bottom: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-xs);
  }

  .meta-label {
    color: var(--color-charcoal-light);
  }

  .meta-value {
    font-weight: 600;
    color: var(--color-navy);
  }

  .other-services-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .other-services-list a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-charcoal);
    transition: all var(--transition-fast);
  }

  .other-services-list a:hover {
    background: var(--color-gray-100);
    color: var(--color-orange);
    transform: translateX(3px);
  }

  .link-arrow {
    color: var(--color-orange);
  }

  /* CTA Band */
  .cta-band {
    background: var(--color-navy);
    color: var(--color-white);
    padding-block: var(--space-16);
  }

  .cta-band h2 {
    color: var(--color-white);
    font-size: var(--text-3xl);
    margin-bottom: var(--space-2);
  }

  .cta-band p {
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--text-base);
    max-width: 600px;
    margin-inline: auto;
    margin-bottom: var(--space-6);
  }

  .cta-band-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .service-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
