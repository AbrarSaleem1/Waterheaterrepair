---
// TrustStrip — 4 trust badges
---

<section class="trust-strip" aria-label="Trust badges">
  <div class="container">
    <div class="trust-grid">
      <div class="trust-badge">
        <div class="trust-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div class="trust-text">
          <strong>Licensed & Insured</strong>
          <span>Fully certified technicians</span>
        </div>
      </div>
      <div class="trust-badge">
        <div class="trust-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="trust-text">
          <strong>24/7 Emergency Service</strong>
          <span>Day or night, we answer</span>
        </div>
      </div>
      <div class="trust-badge">
        <div class="trust-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </div>
        <div class="trust-text">
          <strong>Phone Estimates</strong>
          <span>Upfront quote when you call</span>
        </div>
      </div>
      <div class="trust-badge">
        <div class="trust-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>
        </div>
        <div class="trust-text">
          <strong>Satisfaction Guaranteed</strong>
          <span>We stand behind our work</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .trust-strip {
    background: var(--color-white);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-gray-200);
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  .trust-badge {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
  }

  .trust-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background: rgba(27, 42, 74, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-navy);
  }

  .trust-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .trust-text strong {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-navy);
  }

  .trust-text span {
    font-size: var(--text-xs);
    color: var(--color-charcoal-light);
  }

  @media (max-width: 1024px) {
    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .trust-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
