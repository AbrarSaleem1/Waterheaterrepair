---
import siteConfig from '../data/site-config.json';
import statesList from '../data/states-list.json';

const currentYear = new Date().getFullYear();
const topStates = [
  statesList.find(s => s.slug === 'south-carolina'),
  statesList.find(s => s.slug === 'north-carolina'),
  statesList.find(s => s.slug === 'florida'),
  statesList.find(s => s.slug === 'georgia'),
  statesList.find(s => s.slug === 'texas'),
  statesList.find(s => s.slug === 'california'),
].filter(Boolean);
---

<footer class="site-footer">
  <div class="footer-main container">
    <div class="footer-grid">
      <!-- Brand Column -->
      <div class="footer-col footer-brand">
        <a href="/" class="footer-logo">
          <span class="logo-icon">🔥</span>
          <span class="logo-text">
            <span class="logo-name">HotWater</span>
            <span class="logo-rescue">Rescue</span>
          </span>
        </a>
        <p class="footer-tagline">Professional water heater repair and installation services available 24/7 across all 50 states. Licensed, insured, and ready when you need us.</p>
        <div class="footer-contact-info">
          <a href={`tel:${siteConfig.phone}`} class="footer-phone phone-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            {siteConfig.phoneFormatted}
          </a>
          <p class="footer-address">{siteConfig.address.full}</p>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="footer-col">
        <h4 class="footer-heading">Quick Links</h4>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/services/">Our Services</a></li>
          <li><a href="/locations/">Service Areas</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/about-us/">About Us</a></li>
          <li><a href="/contact-us/">Contact Us</a></li>
        </ul>
      </div>

      <!-- Services -->
      <div class="footer-col">
        <h4 class="footer-heading">Services</h4>
        <ul class="footer-links">
          <li><a href="/services/electric-water-heater-repair/">Electric Water Heater Repair</a></li>
          <li><a href="/services/gas-water-heater-repair/">Gas Water Heater Repair</a></li>
          <li><a href="/services/tankless-water-heater-installation/">Tankless Water Heater Service</a></li>
          <li><a href="/services/water-heater-replacement/">Water Heater Replacement</a></li>
          <li><a href="/services/commercial-water-heater-services/">Commercial Services</a></li>
        </ul>
      </div>

      <!-- Top States -->
      <div class="footer-col">
        <h4 class="footer-heading">Top Locations</h4>
        <ul class="footer-links">
          {topStates.map((state) => (
            <li><a href={`/locations/${state!.slug}/`}>{state!.name}</a></li>
          ))}
          <li><a href="/locations/" class="footer-link-all">All 50 States →</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="footer-copyright">
        &copy; {currentYear} {siteConfig.businessName}. All rights reserved.
      </p>
      <div class="footer-badges">
        <span class="footer-badge">Licensed & Insured</span>
        <span class="footer-badge">24/7 Service</span>
        <span class="footer-badge">All 50 States</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy);
    color: rgba(255, 255, 255, 0.8);
  }

  .footer-main {
    padding-block: var(--space-16) var(--space-10);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: var(--space-10);
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .footer-logo .logo-icon {
    font-size: 1.4rem;
  }

  .footer-logo .logo-name {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--color-white);
  }

  .footer-logo .logo-rescue {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.75rem;
    color: var(--color-red);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .footer-logo .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .footer-tagline {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-5);
    color: rgba(255, 255, 255, 0.65);
  }

  .footer-contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-phone {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .footer-address {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
  }

  .footer-heading {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-base);
    color: var(--color-white);
    margin-bottom: var(--space-5);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-links a {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.7);
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--color-white);
  }

  .footer-link-all {
    color: var(--color-orange) !important;
    font-weight: 600;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-block: var(--space-5);
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-copyright {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
  }

  .footer-badges {
    display: flex;
    gap: var(--space-3);
  }

  .footer-badge {
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-3);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    color: rgba(255, 255, 255, 0.6);
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .footer-bottom-inner {
      flex-direction: column;
      text-align: center;
    }

    .footer-badges {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>
