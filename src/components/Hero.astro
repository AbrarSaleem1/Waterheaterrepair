---
import siteConfig from '../data/site-config.json';

export interface Props {
  title: string;
  subtitle?: string;
  showCtas?: boolean;
  breadcrumbs?: { label: string; href?: string }[];
  variant?: 'full' | 'short';
  backgroundImage?: string;
}

const {
  title,
  subtitle,
  showCtas = true,
  breadcrumbs,
  variant = 'full',
  backgroundImage,
} = Astro.props;
---

<section class:list={["hero", `hero-${variant}`]}>
  {backgroundImage && (
    <div class="hero-bg">
      <img src={backgroundImage} alt="" loading="eager" width="1920" height="800" />
    </div>
  )}
  <div class="hero-overlay"></div>
  <div class="hero-content container">
    {breadcrumbs && breadcrumbs.length > 0 && (
      <nav class="hero-breadcrumb" aria-label="Breadcrumb">
        <ol>
          {breadcrumbs.map((crumb, i) => (
            <li>
              {crumb.href ? (
                <a href={crumb.href}>{crumb.label}</a>
              ) : (
                <span aria-current="page">{crumb.label}</span>
              )}
              {i < breadcrumbs.length - 1 && <span class="breadcrumb-sep" aria-hidden="true">/</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <h1 class="hero-title">{title}</h1>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    {showCtas && (
      <div class="hero-ctas">
        <a href={`tel:${siteConfig.phone}`} class="btn btn-primary btn-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call {siteConfig.phoneFormatted}
        </a>
        <a href="/contact-us/" class="btn btn-secondary btn-lg">Request an Estimate</a>
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-navy);
    overflow: hidden;
  }

  .hero-full {
    padding: var(--space-24) 0 var(--space-20);
    min-height: 440px;
    display: flex;
    align-items: center;
  }

  .hero-short {
    padding: var(--space-16) 0 var(--space-12);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(27, 42, 74, 0.92) 0%,
      rgba(27, 42, 74, 0.8) 50%,
      rgba(18, 29, 51, 0.88) 100%
    );
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 800px;
  }

  .hero-breadcrumb {
    margin-bottom: var(--space-5);
  }

  .hero-breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
  }

  .hero-breadcrumb li {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .hero-breadcrumb a {
    color: rgba(255, 255, 255, 0.7);
    transition: color var(--transition-fast);
  }

  .hero-breadcrumb a:hover {
    color: var(--color-white);
  }

  .hero-breadcrumb span[aria-current] {
    color: var(--color-orange);
    font-weight: 500;
  }

  .breadcrumb-sep {
    color: rgba(255, 255, 255, 0.4);
    margin-inline: var(--space-1);
  }

  .hero-title {
    color: var(--color-white);
    font-size: var(--text-5xl);
    margin-bottom: var(--space-4);
    max-width: 700px;
  }

  .hero-subtitle {
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--text-xl);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
    max-width: 600px;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  @media (max-width: 768px) {
    .hero-full {
      padding: var(--space-16) 0 var(--space-12);
      min-height: auto;
    }

    .hero-title {
      font-size: var(--text-3xl);
    }

    .hero-subtitle {
      font-size: var(--text-lg);
    }

    .hero-ctas {
      flex-direction: column;
    }

    .hero-ctas .btn {
      text-align: center;
    }
  }
</style>
